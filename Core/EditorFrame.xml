<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <Frame name="STRNoteEditorTemplate"
           mixin="STRNoteEditorMixin"
           virtual="true">
        <Size x="196" y="96"/>
        <Frames>
            <Frame parentKey="ScrollingEditBox"
                   inherits="ScrollingEditBoxTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT"/>
                    <Anchor point="BOTTOMRIGHT" y="24"/>
                </Anchors>
            </Frame>

            <EventFrame parentKey="ScrollBar"
                        inherits="MinimalScrollBar">
                <Anchors>
                    <Anchor point="TOPRIGHT" relativeKey="$parent.ScrollingEditBox" relativePoint="TOPRIGHT"/>
                    <Anchor point="BOTTOMRIGHT" relativeKey="$parent.ScrollingEditBox" relativePoint="BOTTOMRIGHT"/>
                </Anchors>
            </EventFrame>

            <!-- The toggle button is a POI button because I'm lazy and I want to reuse everything. -->
            <Button parentKey="ToggleButton"
                    inherits="POIButtonTemplate, STRAnnotationGlobalFillTemplate"
                    mixin="STRNoteEditorToggleButtonMixin"
                    hidden="false">
                <Anchors>
                    <Anchor point="BOTTOMRIGHT"/>
                </Anchors>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnHide method="OnHide"/>
        </Scripts>
    </Frame>
</Ui>
