<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <Button name="STRPinTemplate" inherits="POIButtonTemplate" virtual="true">
        <NormalTexture parentKey="NormalTexture"
                       atlas="UI-QuestPoi-QuestNumber"
                       useAtlasSize="true">
            <Anchors>
                <Anchor point="CENTER"/>
            </Anchors>
        </NormalTexture>
        <PushedTexture parentKey="PushedTexture"
                       atlas="UI-QuestPoi-QuestNumber-Pressed"
                       useAtlasSize="true">
            <Anchors>
                <Anchor point="CENTER"/>
            </Anchors>
        </PushedTexture>
        <Layers>
            <Layer level="BACKGROUND" textureSubLevel="-1">
                <Texture parentKey="LinkGlow"
                         atlas="ui-questpoi-outerglow"
                         alphaMode="ADD"
                         hidden="true">
                    <Size x="75" y="75"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK" textureSubLevel="1">
                <Texture parentKey="GlobalFill"
                         atlas="UI-QuestPoi-QuestNumber-SuperTracked"
                         useAtlasSize="true"
                         desaturated="true"
                         hidden="true">
                    <Color r="0.15" g="0.64" b="0.8"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
                <MaskTexture atlas="CircleMaskScalable"
                             hWrapMode="CLAMPTOBLACKADDITIVE"
                             vWrapMode="CLAMPTOBLACKADDITIVE">
                    <Size x="18" y="18"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                    <MaskedTextures>
                        <MaskedTexture childKey="GlobalFill"/>
                    </MaskedTextures>
                </MaskTexture>
            </Layer>
            <Layer level="OVERLAY">
                <Texture parentKey="HighlightTexture"
                         atlas="UI-QuestPoi-InnerGlow"
                         useAtlasSize="true"
                         alphaMode="ADD"
                         hidden="true">
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
    </Button>

    <Button name="STRMapAnnotationPinTemplate"
            inherits="MapPinPingTemplate, STRPinTemplate"
            mixin="STRMapAnnotationPinMixin"
            virtual="true">
        <Size x="20" y="20"/>
    </Button>

    <Button name="STRClusterAnnotationPinTemplate"
            inherits="STRPinTemplate"
            mixin="STRAnnotationButtonMixin"
            registerForClicks="LeftButtonUp, RightButtonUp"
            virtual="true">
        <Scripts>
            <OnEnter method="OnMouseEnter"/>
            <OnLeave method="OnMouseLeave"/>
        </Scripts>
    </Button>

    <Button name="STRDirectClusterPinTemplate"
            inherits="STRPinTemplate"
            mixin="STRClusterPinMixin"
            virtual="true">
    </Button>

    <Button name="STROverviewClusterPinTemplate"
            inherits="STRPinTemplate"
            mixin="STRClusterPinMixin"
            virtual="true">
    </Button>
</Ui>
